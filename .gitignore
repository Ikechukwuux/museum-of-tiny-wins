# Root .gitignore — Museum of Tiny Wins
# Canonical app lives in /mtw-app (see CURRENT_STATE.md).
# Patterns are intentionally non-anchored so they apply to the app subtree.

# dependencies
node_modules/
.pnp
.pnp.*

# next.js build output
.next/
out/

# production
build/

# testing
coverage/

# env files (do not commit real credentials)
.env*

# typescript
*.tsbuildinfo
next-env.d.ts

# vercel
.vercel

# misc
.DS_Store
*.pem

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
